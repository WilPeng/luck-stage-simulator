# ===== 必填 =====
# MongoDB 连接串
MONGODB_URI=mongodb://127.0.0.1:27017/bigbrother

# JWT 签名密钥（务必使用足够长的随机字符串，切勿使用默认值）
JWT_SECRET=please_change_me_to_a_long_random_secret

# 服务端口
PORT=3000

# ===== 安全 =====
# 不再自动创建 admin / ADMIN2026 默认管理员账号。
# 如需引导创建/修复管理员，请同时设置下面两项：
#   - 用户名不存在时：创建该管理员账号；
#   - 用户名已存在且密码为空/不可查看(bcrypt)时：重置为该密码。
# 已有可登录的管理员后，可在管理端创建更多账号，无需继续保留这两项。
BB_ADMIN_USERNAME=
BB_ADMIN_PASSWORD=

# 房客密码可逆加密密钥（管理员端需要能查看密码，因此存储为可逆加密）。
# 建议设置为独立随机字符串；未设置时回退使用 JWT_SECRET。
# 一旦启用不可随意更换，否则历史密码将无法解密。
PASSWORD_ENC_KEY=

# ===== 水平扩展（可选） =====
# 配置后启用 Socket.IO Redis Adapter，支持多进程/多实例广播。
# REDIS_URL=redis://127.0.0.1:6379
REDIS_URL=
